# Copy to .env and fill in what you have. .env is gitignored — never commit it.
# Everything works with NO credentials at all: DRY_RUN defaults to true, so the
# full pipeline (webhook -> agent -> draft -> dispatch) runs end-to-end and logs
# the exact payloads it would have sent, without charging or messaging anyone.

# --- Core ---
DB_PATH=AI Revenue Recovery Platform (SQLite).db
DRY_RUN=true
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Admin auth for mutation endpoints (/simulate/event, /simulate/reply, /decisions/*/approve|reject) ---
# When set, those endpoints require an `X-Admin-API-Key: <this value>` header.
# When unset, they answer loopback clients only. Set this before deploying.
ADMIN_API_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local testing only: accept unsigned webhooks, honored ONLY for loopback
# clients. Never rely on this in a deployed environment.
RAZORPAY_WEBHOOK_BYPASS=false
# Merchant that webhook-ingested events are attributed to (required when the
# database holds more than one merchant).
DEFAULT_MERCHANT_ID=
PAYMENT_LINK_EXPIRE_HOURS=72

# --- Twilio (WhatsApp / SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Public URL Twilio should POST delivery receipts to (your deployed
# /webhooks/twilio/status). Unset: sends carry no status callback.
TWILIO_STATUS_CALLBACK_URL=

# --- Dispatch retry policy (live sends only; DRY_RUN never retries) ---
# Retries apply ONLY to connection-establishment failures — the request
# provably never reached the provider. Uncertain deliveries (timeout/5xx
# after the request may have arrived) are never auto-retried.
DISPATCH_MAX_ATTEMPTS=3
DISPATCH_RETRY_BACKOFF_SECONDS=2.0

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Gemini (message drafting) ---
# Without a key, messages fall back to a clearly-marked deterministic template.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Agent behaviour ---
# Policy-approved decisions below this confidence are held for a human in the
# review queue instead of auto-dispatching.
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.5
# Background worker: polls for undecided opportunities on this interval.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=60
