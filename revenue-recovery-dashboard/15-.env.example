# Copy to .env to point the dashboard at a backend other than the default.
# Default when unset: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Must match ADMIN_API_KEY in the backend's .env for the review queue's
# Approve & Send / Dismiss buttons to work. Leave empty for local dev when
# the backend also has no key configured (mutations are loopback-only then).
VITE_ADMIN_API_KEY=
